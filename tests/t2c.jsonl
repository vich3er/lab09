{"id": "T01", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Вивести список пацієнтів та їхніх медичних пристроїв", "cypher": "MATCH (p:Patient)-[:IS_MONITORED_BY]->(d:MedicalDevice) RETURN p.fullName, d.deviceId LIMIT 10;", "is_valid": true, "validation_errors": []}
{"id": "T02", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Знайти пацієнтів із пульсом понад 110 уд/хв", "cypher": "MATCH (p:Patient)-[:HAS_VITAL_SIGN]->(v:VitalSign) WHERE v.vitalType = 'HeartRate' AND v.valueNumeric > 110 RETURN p.fullName, v.valueNumeric LIMIT 10;", "is_valid": true, "validation_errors": []}
{"id": "T03", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Показати пацієнтів лікаря doc_smith", "cypher": "MATCH (hp:HealthcareProvider {providerId: 'doc_smith'})-[:TREATS]->(p:Patient) RETURN p.fullName LIMIT 15;", "is_valid": true, "validation_errors": []}
{"id": "T04", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Отримати пацієнтів із негативними відгуками", "cypher": "MATCH (p:Patient)-[:SUBMITTED]->(f:PatientFeedback {sentimentLabel: 'Negative'}) RETURN p.fullName, f.feedbackText LIMIT 10;", "is_valid": true, "validation_errors": []}
{"id": "T05", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Знайти пацієнтів з діагнозом Артеріальна гіпертензія", "cypher": "MATCH (p:Patient)-[:HAS_CONDITION]->(c:MedicalCondition {name: 'Артеріальна гіпертензія'}) RETURN p.fullName LIMIT 20;", "is_valid": true, "validation_errors": []}
{"id": "T06", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Вивести пацієнтів зі скаргою на задишку", "cypher": "MATCH (p:Patient)-[:REPORTS_SYMPTOM]->(s:Symptom {name: 'Задишка'}) RETURN p.fullName LIMIT 10;", "is_valid": true, "validation_errors": []}
{"id": "T07", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Показати дії, виконані медичним персоналом", "cypher": "MATCH (hp:HealthcareProvider)-[:PERFORMED]->(a:Action) RETURN hp.name, a.actionType LIMIT 10;", "is_valid": true, "validation_errors": []}
{"id": "T08", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Вивести топ-5 найвпливовіших вузлів за PageRank", "cypher": "MATCH (n:Patient) RETURN n.fullName, n.pagerank ORDER BY n.pagerank DESC LIMIT 5;", "is_valid": true, "validation_errors": []}
{"id": "T09", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Знайти пацієнтів зі спільноти Louvain 104", "cypher": "MATCH (p:Patient {community: 104}) RETURN p.fullName LIMIT 15;", "is_valid": true, "validation_errors": []}
{"id": "T10", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Яких пацієнтів лікує доктор Сміт?", "cypher": "MATCH (d:Doctor {name: 'Д-р Сміт Джон'})-[:CURES]->(p:Patient) RETURN p.fullName LIMIT 10;", "is_valid": false, "validation_errors": ["Помилка схеми: невідома мітка вузла :Doctor", "Помилка схеми: невідомий тип зв'язку :CURES"]}
{"id": "T11", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Оновити вік пацієнта patient_01 на 50 років", "cypher": "MATCH (p:Patient {patientId: 'patient_01'}) SET p.age = 50 RETURN p.fullName LIMIT 1;", "is_valid": false, "validation_errors": ["Порушення read-only: заборонений оператор SET"]}
{"id": "T12", "system_prompt_ref": "READ_ONLY_MEDICAL_KG_SCHEMA", "question": "Вивести всі критичні життєві показники без обмеження", "cypher": "MATCH (p:Patient)-[:HAS_VITAL_SIGN]->(v:VitalSign) WHERE v.valueNumeric > 130 RETURN p.fullName, v.valueNumeric;", "is_valid": false, "validation_errors": ["Порушення політики безпеки: відсутній оператор LIMIT"]}
